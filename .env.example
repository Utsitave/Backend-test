# Database
DATABASE_URL=mysql+aiomysql://iot_user:strong_password@localhost:3306/iot_db

# API Keys — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRAFANA_API_KEY=change_me_grafana_key
ADMIN_API_KEY=change_me_admin_key
API_KEY_HMAC_SECRET=change_me_at_least_32_chars_secret_here

# Certificate Authority
CA_CERT_PATH=certs/ca.crt
CA_KEY_PATH=certs/ca.key
CA_KEY_PASSWORD=
CA_COMMON_NAME=IoT System CA
CA_ORG=IoT System
CERT_VALIDITY_DAYS=365

# TLS — leave empty to run plain HTTP (use a reverse proxy for TLS in prod)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Server
HOST=0.0.0.0
PORT=8443
LOG_LEVEL=INFO
